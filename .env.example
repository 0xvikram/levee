# Copy to .env and fill in. Never commit .env.
# Hedera testnet operator (create at https://portal.hedera.com, comes with 1,000 test HBAR)
HEDERA_NETWORK=testnet
OPERATOR_ID=0.0.xxxxxxx
OPERATOR_KEY=302e...   # ECDSA (hex) or DER private key

# Mirror Node
MIRROR_URL=https://testnet.mirrornode.hedera.com

# Arkiv (Rabdi testnet). Get test GLM + access key at https://hub.arkiv.network
ARKIV_RPC=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_PRIVATE_KEY=0x...
ARKIV_ACCESS_KEY=

# Rules
CAP_PER_TRANSFER=10000
CAP_PER_DAY=50000
HEARTBEAT_SECONDS=60
PASS_SECONDS=180
